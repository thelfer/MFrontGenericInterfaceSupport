# Libraries of material properties generated by the `generic-parallel`
# interface of `MFront` (`TFEL` 5.2 or later), compiled by the C++ compiler
# of `MGIS`. Only the backends whose sources are standard C++ sources are
# supported (`stlpar`). The sources are generated in a directory of their
# own.
#
# usage: mfront_generic_parallel_material_properties_check_library(name
#                                                    backend properties...)
function(mfront_generic_parallel_material_properties_check_library name
                                                                 backend)
  set(_directory
    "${CMAKE_CURRENT_BINARY_DIR}/generic-parallel-material-properties-${backend}")
  file(MAKE_DIRECTORY "${_directory}")
  set(_configuration "${_directory}/configuration.json")
  file(WRITE "${_configuration}"
    "interfaces_options: {\n"
    "  generic-parallel: {\n"
    "    backend: \"${backend}\"\n"
    "  }\n"
    "}\n")
  set(_sources)
  foreach(source ${ARGN})
    set(_file "${CMAKE_CURRENT_SOURCE_DIR}/${source}.mfront")
    set(_output "${_directory}/src/${source}-generic-parallel-${backend}.cxx")
    add_custom_command(
      OUTPUT "${_output}"
      COMMAND "${MFRONT}"
      ARGS "--interface=generic-parallel"
      ARGS "--configuration-file=${_configuration}"
      ARGS "${_file}"
      DEPENDS "${_file}" "${MFRONT}" "${_configuration}"
      WORKING_DIRECTORY "${_directory}"
      COMMENT "mfront source ${_file} (generic-parallel interface)")
    list(APPEND _sources "${_output}")
  endforeach(source ${ARGN})
  add_library(${name} SHARED EXCLUDE_FROM_ALL ${_sources})
  add_dependencies(check ${name})
  target_include_directories(${name}
    PRIVATE "${_directory}/include"
    PRIVATE "${TFEL_INCLUDE_PATH}")
  target_compile_definitions(${name} PRIVATE MFRONT_COMPILING)
  if(backend STREQUAL "stlpar")
    # libraries required by the parallel algorithms of the standard library
    # (see the `enable-parallel-stl-algorithms` option)
    target_link_libraries(${name} PRIVATE ${MGIS_ADDITIONAL_LIBRARIES})
    if(UNIX AND NOT APPLE)
      # the library stays loaded until the end of the process: the threads
      # of TBB may still run when the libraries are unloaded at exit (as in
      # the configuration files of the stlpar backend of TFEL)
      target_link_libraries(${name} PRIVATE "-Wl,-z,nodelete")
    endif(UNIX AND NOT APPLE)
  endif(backend STREQUAL "stlpar")
endfunction(mfront_generic_parallel_material_properties_check_library)
