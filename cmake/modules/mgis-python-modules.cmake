# Python modules of MGIS: definition of the modules and generation of
# their stubs using pybind11-stubgen, following the same design as TFEL
# (cf. cmake/modules/tfel-python-modules.cmake in thelfer/tfel).

# Root directory of the python modules in the build tree
set(MGIS_PYTHON_MODULES_BUILD_DIR "${PROJECT_BINARY_DIR}/bindings/python")

# Name of the python package in the build tree and in the installation:
# mgis or mgis_<suffix> when MGIS_APPEND_SUFFIX is ON. Only the name of the
# package carries the suffix, not the names of the modules.
if(MGIS_APPEND_SUFFIX)
  set(MGIS_PYTHON_PACKAGE_NAME "mgis_${MGIS_SUFFIX_FOR_PYTHON_MODULES}")
else(MGIS_APPEND_SUFFIX)
  set(MGIS_PYTHON_PACKAGE_NAME "mgis")
endif(MGIS_APPEND_SUFFIX)

# Define a pybind11 module of the mgis package.
#
# \param fullname name of the cmake target, py_<fullname>
# \param name name of the module, as imported by python
# \param ARGN sources of the module
function(mgis_python_module fullname name)
  if(${ARGC} LESS 3)
    message(FATAL_ERROR "mgis_python_module: no source specified")
  endif(${ARGC} LESS 3)
  add_library(py_${fullname} MODULE ${ARGN})
  target_include_directories(py_${fullname} PRIVATE
   $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/bindings/python/include>)
  if(TARGET pybind11::lto)
    target_link_libraries(py_${fullname} PRIVATE
      MFrontGenericInterface
      pybind11::module pybind11::lto pybind11::windows_extras)
  else(TARGET pybind11::lto)
    target_link_libraries(py_${fullname} PRIVATE
      MFrontGenericInterface
      pybind11::module pybind11::windows_extras)
  endif(TARGET pybind11::lto)
  pybind11_extension(py_${fullname})
  if(NOT MSVC AND NOT ${CMAKE_BUILD_TYPE} MATCHES Debug|RelWithDebInfo)
    # Strip unnecessary sections of the binary on Linux/macOS
    pybind11_strip(py_${fullname})
  endif()
  set_target_properties(py_${fullname} PROPERTIES PREFIX "")
  set_target_properties(py_${fullname} PROPERTIES OUTPUT_NAME ${name})
  set_target_properties(py_${fullname} PROPERTIES
    CXX_VISIBILITY_PRESET "hidden"
    CUDA_VISIBILITY_PRESET "hidden")
  # The modules shall be next to the __init__.py script of their package,
  # which imports them. Multi-configuration generators append the name of
  # the configuration to the output directory, unless it holds a generator
  # expression.
  set_target_properties(py_${fullname} PROPERTIES
    LIBRARY_OUTPUT_DIRECTORY
    "$<1:${MGIS_PYTHON_MODULES_BUILD_DIR}/${MGIS_PYTHON_PACKAGE_NAME}>")
  # installation
  install(TARGETS py_${fullname}
    DESTINATION ${MGIS_PYTHON_MODULES_INSTALL_DIRECTORY}
    COMPONENT python_bindings)
  python_module_stubgen(py_${fullname} ${name})
endfunction(mgis_python_module)

# Register a python module so that a stub file is generated for it using
# pybind11-stubgen by the generate_python_stubs function.
#
# Nothing is done if the enable-pybind11-stubgen option is OFF or if
# pybind11-stubgen has not been found.
#
# \param target target associated with the python module
# \param name name of the module, as it is imported by python
function(python_module_stubgen target name)
  if(NOT (enable-pybind11-stubgen AND pybind11_stubgen))
    return()
  endif(NOT (enable-pybind11-stubgen AND pybind11_stubgen))
  set_property(GLOBAL APPEND PROPERTY MGIS_PYTHON_STUBGEN_MODULES
    "${target}:${MGIS_PYTHON_PACKAGE_NAME}.${name}")
endfunction(python_module_stubgen)

# Generate the stub files of all the python modules registered by the
# python_module_stubgen function using pybind11-stubgen and install them
# next to the modules they describe.
#
# The stubs are generated by the python-stubs target, which is built when
# the project is built.
#
# This function shall be called after all the calls to add_subdirectory as
# it requires that all the python modules and all the MGIS libraries have
# been declared.
#
# Nothing is done if the enable-pybind11-stubgen option is OFF or if
# pybind11-stubgen has not been found.
function(generate_python_stubs)
  if(NOT (enable-pybind11-stubgen AND pybind11_stubgen))
    return()
  endif(NOT (enable-pybind11-stubgen AND pybind11_stubgen))
  get_property(MGIS_PYTHON_STUBGEN_MODULES
    GLOBAL PROPERTY MGIS_PYTHON_STUBGEN_MODULES)
  if(NOT MGIS_PYTHON_STUBGEN_MODULES)
    return()
  endif(NOT MGIS_PYTHON_STUBGEN_MODULES)
  # Importing a python module triggers the execution of the __init__.py
  # script of the package, which imports the other modules of the package.
  # Hence all the python modules must be built before a stub can be
  # generated.
  set(pybind11_stubgen_dependencies)
  foreach(entry ${MGIS_PYTHON_STUBGEN_MODULES})
    string(REGEX REPLACE ":.*$" "" target "${entry}")
    list(APPEND pybind11_stubgen_dependencies "${target}")
  endforeach(entry ${MGIS_PYTHON_STUBGEN_MODULES})
  # the environment variables passed to pybind11-stubgen
  set(mgis_stubgen_pythonpath "${MGIS_PYTHON_MODULES_BUILD_DIR}")
  if(WIN32)
    # On windows, the directories containing the dynamic link libraries of
    # the build tree, which the python modules depend on, are neither those
    # of the python interpreter nor those of the python modules. The python
    # interpreter ignores the PATH variable when it imports an extension
    # module, but the directories can be added to the search path of the
    # dynamic loader with the os.add_dll_directory function. This is done by
    # a sitecustomize script, which is placed in a directory added to the
    # PYTHONPATH variable for the execution of pybind11-stubgen.
    #
    # The MGIS python modules depend on the MGIS libraries, given by the
    # MGIS_LIBRARIES global property, and on the TFEL libraries, installed
    # in the bin directory of TFELHOME.
    get_property(mgis_stubgen_libraries GLOBAL PROPERTY MGIS_LIBRARIES)
    set(mgis_stubgen_library_directories)
    foreach(mgis_stubgen_library ${mgis_stubgen_libraries})
      list(APPEND mgis_stubgen_library_directories
           "$<TARGET_FILE_DIR:${mgis_stubgen_library}>")
    endforeach(mgis_stubgen_library ${mgis_stubgen_libraries})
    if(TFEL_FOUND)
      list(APPEND mgis_stubgen_library_directories "${TFELHOME}/bin")
    endif(TFEL_FOUND)
    string(JOIN "\", r\"" mgis_stubgen_library_directories
           ${mgis_stubgen_library_directories})
    set(mgis_stubgen_sitecustomize_directory
        "${PROJECT_BINARY_DIR}/bindings/stubgen/$<CONFIG>")
    file(GENERATE
      OUTPUT "${mgis_stubgen_sitecustomize_directory}/sitecustomize.py"
      CONTENT "import os

for _directory in dict.fromkeys((r\"${mgis_stubgen_library_directories}\", )):
    if os.path.isdir(_directory):
        os.add_dll_directory(_directory)
")
    # the two paths of the PYTHONPATH variable are separated by a semicolon
    string(REPLACE ";" "$<SEMICOLON>" mgis_stubgen_pythonpath
           "${mgis_stubgen_sitecustomize_directory};${MGIS_PYTHON_MODULES_BUILD_DIR}")
  endif(WIN32)
  set(pybind11_stubgen_files)
  foreach(entry ${MGIS_PYTHON_STUBGEN_MODULES})
    string(REGEX REPLACE "^[^:]*:" "" module "${entry}")
    string(REPLACE "." "/" module_path "${module}")
    set(stub_file "${MGIS_PYTHON_MODULES_BUILD_DIR}/${module_path}.pyi")
    add_custom_command(OUTPUT "${stub_file}"
      COMMAND "${CMAKE_COMMAND}" -E env
              "PYTHONPATH=${mgis_stubgen_pythonpath}"
              "${Python_EXECUTABLE}" -m pybind11_stubgen "${module}"
              "--output-dir" "${MGIS_PYTHON_MODULES_BUILD_DIR}"
      DEPENDS ${pybind11_stubgen_dependencies}
      COMMENT "Generating stub for python module ${module}"
      VERBATIM)
    list(APPEND pybind11_stubgen_files "${stub_file}")
    install(FILES "${stub_file}"
      DESTINATION "${MGIS_PYTHON_MODULES_INSTALL_DIRECTORY}"
      COMPONENT python_bindings)
  endforeach(entry ${MGIS_PYTHON_STUBGEN_MODULES})
  add_custom_target(python-stubs ALL
    DEPENDS ${pybind11_stubgen_files})
endfunction(generate_python_stubs)
