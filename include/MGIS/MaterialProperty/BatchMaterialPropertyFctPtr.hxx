#ifndef LIB_MGIS_MATERIALPROPERTY_BATCHMATERIALPROPERTYFCTPTR_HXX
#define LIB_MGIS_MATERIALPROPERTY_BATCHMATERIALPROPERTYFCTPTR_HXX

#include "MGIS/MaterialProperty/MaterialPropertyFctPtr.hxx"
#include "MGIS/BackendExecutionPolicy.h"

/*!
 * \brief version of the functions generated by the `generic-parallel`
 * interface for material properties supported by MGIS. It is compared to
 * the version exported by the libraries
 * (`<name>_generic_parallel_api_version` symbol) when a material property
 * is loaded: any other version is refused. This version and the structures
 * declared in this file are copies of the ones declared in the
 * `MFront/GenericParallelMaterialProperty/MaterialProperty.h` header of
 * `TFEL`, with the same members in the same order, so that `MGIS` does not
 * depend on `TFEL` at compile time.
 */
#define MGIS_MP_GENERIC_PARALLEL_API_VERSION 1

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/*!
 * \brief statistics of the evaluation of a material property on a batch of
 * points (copy of the `mfront_gpmp_Statistics` structure of `TFEL`). The
 * device only updates them when an event occurs at a point (the `stlpar`
 * backend merges the statuses of the points by a reduction on the host). They
 * are initialized by `mgis_mp_initializeBatchStatistics` and analysed by the
 * report function of the material property.
 */
typedef struct mgis_mp_BatchStatistics {
  /*!
   * \brief number of points where the evaluation failed (physical bound
   * violated, bound violated with the strict policy, invalid result)
   */
  unsigned long long number_of_failures;
  /*!
   * \brief opaque key of the first point where the evaluation failed, or
   * `~0` if no point failed. Only the report function of the material
   * property decodes it.
   */
  unsigned long long first_failure;
  //! \brief number of points where a bound is violated with the warning
  //! policy
  unsigned long long number_of_unreliable_results;
  /*!
   * \brief opaque key of the first point where the result is unreliable, or
   * `~0` if no result is unreliable
   */
  unsigned long long first_unreliable_result;
} mgis_mp_BatchStatistics;

/*!
 * \brief initialize the statistics of an evaluation (copy of the
 * `mfront_gpmp_initializeStatistics` function of `TFEL`)
 * \param[out] s: statistics
 */
static inline void mgis_mp_initializeBatchStatistics(
    mgis_mp_BatchStatistics* const s) {
  s->number_of_failures = 0;
  s->first_failure = ~0ull;
  s->number_of_unreliable_results = 0;
  s->first_unreliable_result = ~0ull;
} /* end of mgis_mp_initializeBatchStatistics */

/*!
 * \brief values of an argument on a batch of points (copy of the
 * `mfront_gpmp_ConstField` structure of `TFEL`): the value at the `i`-th
 * point is `values[i * point_stride]`
 */
typedef struct mgis_mp_BatchConstField {
  //! \brief pointer to the first value
  const mgis_real* values;
  //! \brief stride between two points: a null stride denotes a uniform value
  mgis_size_type point_stride;
} mgis_mp_BatchConstField;

/*!
 * \brief values of the output on a batch of points (copy of the
 * `mfront_gpmp_Field` structure of `TFEL`)
 */
typedef struct mgis_mp_BatchField {
  //! \brief pointer to the first value
  mgis_real* values;
  //! \brief stride between two points (null for a batch of one point only)
  mgis_size_type point_stride;
} mgis_mp_BatchField;

/*!
 * \brief data of the evaluation of a material property on a batch of
 * points (copy of the `mfront_gpmp_BatchData` structure of `TFEL`). The
 * array of the arguments is read on the host.
 */
typedef struct mgis_mp_BatchData {
  //! \brief number of points
  mgis_size_type number_of_points;
  //! \brief output values
  mgis_mp_BatchField output;
  //! \brief arguments, read on the host (null if there is no argument)
  const mgis_mp_BatchConstField* arguments;
  //! \brief number of arguments
  mgis_size_type number_of_arguments;
  //! \brief out of bounds policy
  mgis_mp_OutOfBoundsPolicy out_of_bounds_policy;
  //! \brief status of each point, or null
  int* statuses;
  /*!
   * \brief statistics of the evaluation, or null. If given, the output
   * status only reports the errors of the batch, and the report function
   * gives the result once the computations are completed. Asynchronous
   * evaluations require statistics.
   */
  mgis_mp_BatchStatistics* statistics;
  /*!
   * \brief execution policy of the backend of the library, or null for the
   * default policy of the backend (see `MGIS/BackendExecutionPolicy.h`)
   */
  const mgis_gp_AbstractBackendExecutionPolicy* execution_policy;
} mgis_mp_BatchData;

/*!
 * \brief summary of the evaluation of a material property on a batch of
 * points (copy of the `mfront_gpmp_OutputStatus` structure of `TFEL`). The
 * `status` member is also the value returned by the functions:
 *
 * - `0`: the result has been evaluated at all points;
 * - `1`: a bound is violated with the warning policy at some points;
 * - `-1`: a physical bound, or a bound with the strict policy, is violated
 *   at some points (the output is `NaN` at those points);
 * - `-4`: the result is not finite at some points;
 * - `-5`: invalid arguments, nothing was computed;
 * - `-6`: invalid parameters, nothing was computed;
 * - `-7`: runtime error of the backend.
 *
 * The codes `0`, `1`, `-1` and `-4` are the codes of the `generic`
 * interface at the reported point: the first point where the evaluation
 * failed, otherwise the first point where the result is unreliable.
 */
typedef struct mgis_mp_BatchOutputStatus {
  //! \brief status
  int status;
  //! \brief number of points where the evaluation failed
  mgis_size_type number_of_failures;
  /*!
   * \brief index of the first point where the evaluation failed, or the
   * maximal value of the type if no point failed
   */
  mgis_size_type first_failure_index;
  //! \brief number of points where a bound is violated with the warning
  //! policy
  mgis_size_type number_of_unreliable_results;
  /*!
   * \brief index of the first point where the result is unreliable, or the
   * maximal value of the type if no result is unreliable
   */
  mgis_size_type first_unreliable_result_index;
  /*!
   * \brief rank of the variable of the check retained at the reported point
   * for the statuses `-1` and `1` (see `mgis_mp_OutputStatus`), zero
   * otherwise
   */
  int bounds_status;
  //! \brief error message
  char msg[512];
} mgis_mp_BatchOutputStatus;

/*!
 * \brief type of a function evaluating a material property on a batch of
 * points (`<name>_generic_parallel` function)
 */
typedef int(MGIS_MATERIALPROPERTY_ADDCALL_PTR
                mgis_mp_BatchMaterialPropertyFctPtr)(
    mgis_mp_BatchOutputStatus* const, const mgis_mp_BatchData* const);

/*!
 * \brief type of the function analysing the statistics of an evaluation
 * of a material property, once the evaluation is completed
 * (`<name>_generic_parallel_report` function), and reporting the result in
 * an output status, as a synchronous evaluation does
 */
typedef int(MGIS_MATERIALPROPERTY_ADDCALL_PTR mgis_mp_BatchReportFctPtr)(
    mgis_mp_BatchOutputStatus* const, const mgis_mp_BatchStatistics* const);

#ifdef __cplusplus
}  // end of extern "C"
#endif /* __cplusplus */

#ifdef __cplusplus

namespace mgis::material_property {

  //! \brief a simple alias
  using BatchStatistics = ::mgis_mp_BatchStatistics;
  //! \brief a simple alias
  using BatchConstField = ::mgis_mp_BatchConstField;
  //! \brief a simple alias
  using BatchField = ::mgis_mp_BatchField;
  //! \brief a simple alias
  using BatchData = ::mgis_mp_BatchData;
  //! \brief a simple alias
  using BatchOutputStatus = ::mgis_mp_BatchOutputStatus;
  //! \brief a simple alias
  using BatchMaterialPropertyFctPtr = ::mgis_mp_BatchMaterialPropertyFctPtr;
  //! \brief a simple alias
  using BatchReportFctPtr = ::mgis_mp_BatchReportFctPtr;

  /*!
   * \brief initialize the statistics of an evaluation (see
   * `mgis_mp_initializeBatchStatistics`)
   * \param[out] s: statistics
   */
  inline void initializeBatchStatistics(BatchStatistics& s) noexcept {
    mgis_mp_initializeBatchStatistics(&s);
  }  // end of initializeBatchStatistics

}  // end of namespace mgis::material_property

#endif /* __cplusplus */

#endif /* LIB_MGIS_MATERIALPROPERTY_BATCHMATERIALPROPERTYFCTPTR_HXX */
