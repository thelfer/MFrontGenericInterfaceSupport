#ifndef LIB_MGIS_MATERIALPROPERTY_MATERIALPROPERTY_HXX
#define LIB_MGIS_MATERIALPROPERTY_MATERIALPROPERTY_HXX

#include <string>
#include <vector>
#include "MGIS/Config.hxx"
#include "MGIS/MaterialProperty/MaterialPropertyFctPtr.hxx"
#include "MGIS/MaterialProperty/BatchMaterialPropertyFctPtr.hxx"

namespace mgis::material_property {

  /*!
   * \brief structure describing a material property
   */
  struct MGIS_EXPORT MaterialProperty {
    //! \brief constructor
    MaterialProperty();
    //! \brief move constructor
    MaterialProperty(MaterialProperty &&);
    //! \brief copy constructor
    MaterialProperty(const MaterialProperty &);
    //! \brief move assignement
    MaterialProperty &operator=(MaterialProperty &&);
    //! \brief standard assignement
    MaterialProperty &operator=(const MaterialProperty &);
    //! \brief destructor
    ~MaterialProperty();
    //! \brief name of the library providing the behaviour
    std::string library;
    //! \brief name of the material property
    std::string material_property;
    /*!
     * \brief name of the `MFront` source file used to generate the material
     * property
     */
    std::string source;
    //! \brief version of `TFEL` used to generate the material property
    std::string tfel_version;
    //! \brief unit system used by the material property
    std::string unit_system;
    /*!
     * \brief pointer to the function implementing the material property at
     * one point, null if the library has no such function (material property
     * generated by the `generic-parallel` interface)
     */
    MaterialPropertyFctPtr fct = nullptr;
    //! \brief output of the material property
    std::string output;
    //! \brief inputs of the material property
    std::vector<std::string> inputs;
    /*!
     * \brief interface of `MFront` used to generate the material property
     * (`<name>_mfront_interface` symbol): `Generic`, `GenericParallel` or
     * empty for the libraries which do not export it. This member is not
     * named `interface`, which is a macro of the headers of Windows.
     */
    std::string mfront_interface;
    /*!
     * \brief version of the functions of batches of points exported by the
     * library (`<name>_generic_parallel_api_version` symbol), zero if the
     * library has no such functions
     */
    unsigned short batch_api_version = 0;
    /*!
     * \brief backend of a library generated by the `generic-parallel`
     * interface (for instance `cuda`, `hip`, `stlpar` or `sycl`), for
     * information only (see `memory_space`), empty for the other interfaces
     */
    std::string backend;
    /*!
     * \brief memory space of the computations of a library generated by the
     * `generic-parallel` interface: `host`, `device` or `any`. The values,
     * the statuses of the points and the statistics given to the functions of
     * batches of points must be accessible in this memory space. Empty for
     * the other interfaces, which compute on the host.
     */
    std::string memory_space;
    /*!
     * \brief identifier of the execution policy expected by a library
     * generated by the `generic-parallel` interface (for instance `cuda` or
     * `sycl:oneapi`): a policy given to the functions of batches of points
     * must have this identifier. Empty for the other interfaces.
     */
    std::string execution_policy;
    /*!
     * \brief pointer to the function implementing the material property on
     * a batch of points, null if the library has no such function
     */
    BatchMaterialPropertyFctPtr batch_fct = nullptr;
    /*!
     * \brief pointer to the function analysing the statistics of an
     * evaluation on a batch of points, null if the library has no such
     * function
     */
    BatchReportFctPtr batch_report_fct = nullptr;
  };  // end of struct MaterialProperty

  /*!
   * \return true if the library provides the functions evaluating the
   * material property on batches of points (`generic-parallel` interface of
   * `MFront`)
   * \param[in] mp: material property
   */
  MGIS_EXPORT bool isGenericParallelMaterialProperty(
      const MaterialProperty &) noexcept;

  /*!
   * \brief load the description of a material property from a library
   *
   * \param[in] l: library name
   * \param[in] b: material property name
   *
   * \note: use of `std::string` rather than `mgis::string_view` is
   * meaningfull here
   */
  MGIS_EXPORT MaterialProperty load(const std::string &, const std::string &);

}  // end of namespace mgis::material_property

#endif /* LIB_MGIS_MATERIALPROPERTY_MATERIALPROPERTY_HXX */
